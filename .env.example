# ==============================================================================
# EvidenCite — Environment Configuration
# Copy this file to .env and populate with your credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# A1: Paper Ingestion & Semantic Search
# ------------------------------------------------------------------------------
# Semantic Scholar API key for citation graph & metadata (https://www.semanticscholar.org/product/api)
SEMANTIC_SCHOLAR_API_KEY=

# ------------------------------------------------------------------------------
# A2: Assisted Pre-labeling & LLM Judge Panel
# ------------------------------------------------------------------------------
# Bearer token for local/remote vLLM endpoints (optional, e.g. for vLLM on GPU instance)
VLLM_API_KEY=

# ------------------------------------------------------------------------------
# A4, A6, A7: Model Training, Evaluation & Experiment Tracking
# ------------------------------------------------------------------------------
# MLflow tracking server URI (e.g. http://localhost:5000 or http://192.168.1.50:5000)
MLFLOW_TRACKING_URI=http://localhost:5000

# Optional host:port used by Google Colab training scripts (e.g. 192.168.1.50:5000)
# MLFLOW_IP=

# Hugging Face token with Read permissions (for downloading model checkpoints in Colab)
HF_TOKEN=

# ------------------------------------------------------------------------------
# A5: Frontier Commercial LLMs via API (Zero/Few-Shot Inference)
# ------------------------------------------------------------------------------
# OpenAI Platform API key (https://platform.openai.com/api-keys)
# Minimum required permission: Restricted -> Model capabilities: Write
OPENAI_API_KEY=

# Google AI Studio / Gemini API key (https://aistudio.google.com/app/apikey)
# Supports both Free Tier (15 RPM / 1,500 RPD) and Pay-As-You-Go with Cloud Billing
GEMINI_API_KEY=
